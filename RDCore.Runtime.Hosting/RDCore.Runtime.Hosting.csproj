<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyTitle>RDCore Runtime Hosting</AssemblyTitle>
    <Description>What a host runs an RD-VBA program with: the composition rdc compose wrote, loaded with no parser, and the machines that run it. The implementation of the SDK's runtime hosting contract.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RDCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- what a deployed host references: RDCore.Runtime.Support and its references, never RDCore.Parsing or ANTLR, whose third-party GPL parts NOTICE's grant
       does not cover. A test fails when one appears. -->
  <ItemGroup>
    <PackageReference Include="RDCore.SDK" Version="$(RDCoreSdkVersion)" />
    <ProjectReference Include="..\RDCore.Runtime.Support\RDCore.Runtime.Support.csproj" />
  </ItemGroup>

</Project>
