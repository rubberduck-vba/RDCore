<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rdc</AssemblyName>
    <StartupObject>RDCore.CLI.Program</StartupObject>
    <AssemblyTitle>RDCore CLI</AssemblyTitle>
    <Description>The RDCore command line: an interactive RD-VBA shell and a language client of the platform, and the host of the RD-VBA runtime environment.</Description>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- the built-in default theme is compiled in; disk themes are discovered from ThemesDiscoveryPath. -->
    <EmbeddedResource Include="Themes\rdc-abyss.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Themes\rdc-dark.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Themes\rdc-light.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Themes\rdc-basic.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <!-- the corpus rdc bench runs when it is given no workspace. -->
    <EmbeddedResource Include="Bench\Corpus\*.bas;Bench\Corpus\*.cls" LogicalName="Bench/Corpus/%(Filename)%(Extension)" />
    <!-- the Excel automation cases of rdc bench-msvba: ExcelCases.bas runs on both sides, Program.bas is the RD-VBA program that calls it. -->
    <EmbeddedResource Include="Bench\Excel\*.bas" LogicalName="Bench/Excel/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RDCore.SDK" Version="$(RDCoreSdkVersion)" />
    <!-- environment-host mode composes the RD-VBA runtime session; RDCore.Runtime is GPLv3, as is this app. -->
    <ProjectReference Include="..\RDCore.Runtime\RDCore.Runtime.csproj" />
    <!-- the session a program runs in, and the runner rdc run shares with a built program. -->
    <ProjectReference Include="..\RDCore.Runtime.Support\RDCore.Runtime.Support.csproj" />
    <!-- the host composes the session with the outside world of the platform it runs on. -->
    <ProjectReference Include="..\RDCore.External.Windows\RDCore.External.Windows.csproj" />
    <!-- rdc bench (and, later, rdc build) parse a workspace and build its symbols in-process, as the language server does. -->
    <ProjectReference Include="..\RDCore.Parsing\RDCore.Parsing.csproj" />
    <ProjectReference Include="..\RDCore.Symbols\RDCore.Symbols.csproj" />
  </ItemGroup>

  <!-- rdc build makes a program's executable out of the .NET application host, and a machine with the .NET runtime has none: only the .NET SDK
       does. so the published rdc ships the one its own executable is made of, laid out as the SDK's packs folder lays it out
       (apphost/packs/Microsoft.NETCore.App.Host.<rid>/<version>/runtimes/<rid>/native/), which is where AppHost.Find looks first. -->
  <Target Name="PublishProgramApplicationHost" AfterTargets="Publish" DependsOnTargets="_GetAppHostPaths" Condition="'$(UseAppHost)' == 'true'">
    <Error Condition="'$(AppHostSourcePath)' == '' or !Exists('$(AppHostSourcePath)')" Text="rdc is published without the .NET application host its programs are made of: none was resolved for $(AssemblyName)." />
    <PropertyGroup>
      <_ProgramAppHostNative>$([System.IO.Path]::GetDirectoryName('$(AppHostSourcePath)'))</_ProgramAppHostNative>
      <_ProgramAppHostRuntime>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('$(_ProgramAppHostNative)'))))</_ProgramAppHostRuntime>
      <_ProgramAppHostVersion>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(_ProgramAppHostNative)'))))))))</_ProgramAppHostVersion>
    </PropertyGroup>
    <Copy SourceFiles="$(AppHostSourcePath)" DestinationFolder="$(PublishDir)apphost/packs/Microsoft.NETCore.App.Host.$(_ProgramAppHostRuntime)/$(_ProgramAppHostVersion)/runtimes/$(_ProgramAppHostRuntime)/native" />
  </Target>

  <!-- rdc build -r <rid> makes a program for a runtime other than its own, out of that runtime's host: the published rdc ships the host of every runtime the
       platform is published for (PlatformRuntimeIdentifiers), from its NuGet pack, beside its own and in the same layout. -->
  <ItemGroup>
    <ProgramAppHostRuntime Include="$(PlatformRuntimeIdentifiers)" />
    <PackageDownload Include="@(ProgramAppHostRuntime->'Microsoft.NETCore.App.Host.%(Identity)')" Version="[$(BundledNETCoreAppPackageVersion)]" />
  </ItemGroup>

  <!-- once for each runtime (Outputs batches the target), except rdc's own, whose host PublishProgramApplicationHost ships. -->
  <Target Name="PublishProgramApplicationHostsOfOtherRuntimes" AfterTargets="PublishProgramApplicationHost" Condition="'$(UseAppHost)' == 'true'" Outputs="%(ProgramAppHostRuntime.Identity)">
    <PropertyGroup>
      <_OtherAppHostRuntime>%(ProgramAppHostRuntime.Identity)</_OtherAppHostRuntime>
      <_OtherAppHostFile Condition="$(_OtherAppHostRuntime.StartsWith('win'))">apphost.exe</_OtherAppHostFile>
      <_OtherAppHostFile Condition="!$(_OtherAppHostRuntime.StartsWith('win'))">apphost</_OtherAppHostFile>
      <_OtherAppHostSource>$(NuGetPackageRoot)microsoft.netcore.app.host.$(_OtherAppHostRuntime.ToLowerInvariant())/$(BundledNETCoreAppPackageVersion.ToLowerInvariant())/runtimes/$(_OtherAppHostRuntime)/native/$(_OtherAppHostFile)</_OtherAppHostSource>
    </PropertyGroup>
    <Error Condition="'$(_OtherAppHostRuntime)' != '$(_ProgramAppHostRuntime)' and !Exists('$(_OtherAppHostSource)')" Text="rdc is published without the .NET application host of $(_OtherAppHostRuntime): $(_OtherAppHostSource) was not restored." />
    <Copy Condition="'$(_OtherAppHostRuntime)' != '$(_ProgramAppHostRuntime)'" SourceFiles="$(_OtherAppHostSource)" DestinationFolder="$(PublishDir)apphost/packs/Microsoft.NETCore.App.Host.$(_OtherAppHostRuntime)/$(BundledNETCoreAppPackageVersion)/runtimes/$(_OtherAppHostRuntime)/native" />
  </Target>

</Project>
