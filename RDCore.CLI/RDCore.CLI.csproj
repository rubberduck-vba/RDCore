<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rdc</AssemblyName>
    <StartupObject>RDCore.CLI.Program</StartupObject>
    <AssemblyTitle>RDCore CLI</AssemblyTitle>
    <Description>The RDCore command line: an interactive RD-VBA shell and a language client of the platform, and the host of the RD-VBA runtime environment.</Description>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- the built-in default theme is compiled in; disk themes are discovered from ThemesDiscoveryPath. -->
    <EmbeddedResource Include="Themes\rdc-abyss.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Themes\rdc-dark.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Themes\rdc-light.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Themes\rdc-basic.theme">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <!-- the corpus rdc bench runs when it is given no workspace. -->
    <EmbeddedResource Include="Bench\Corpus\*.bas;Bench\Corpus\*.cls" LogicalName="Bench/Corpus/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDCore.SDK\RDCore.SDK.csproj" />
    <!-- environment-host mode composes the RD-VBA runtime session; RDCore.Runtime is GPLv3, as is this app. -->
    <ProjectReference Include="..\RDCore.Runtime\RDCore.Runtime.csproj" />
    <!-- the host composes the session with the outside world of the platform it runs on. -->
    <ProjectReference Include="..\RDCore.External.Windows\RDCore.External.Windows.csproj" />
    <!-- rdc bench (and, later, rdc build) parse a workspace and build its symbols in-process, as the language server does. -->
    <ProjectReference Include="..\RDCore.Parsing\RDCore.Parsing.csproj" />
    <ProjectReference Include="..\RDCore.Symbols\RDCore.Symbols.csproj" />
  </ItemGroup>

</Project>
