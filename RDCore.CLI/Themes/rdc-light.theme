{
  "name": "light",
  "author": "9562-7303 Québec inc.",
  "version": "0.3",

  "palette": {
    "shell-bg": "#FFFFFF",
    "shell-fg": "#0C0A50",
    "shell-highlight": "#5f8dd3",
    "shell-highlight-fg": "#0C0A50",

    "error": "#c62828",
    "error-bright": "#b00020",
    "error-dim": "#8e3b3b",
    "error-light": "#e57373",

    "success": "#2e7d32",
    "success-bright": "#1b6b1f",
    "success-dim": "#4c7a4e",
    "success-light": "#81c784",

    "information": "#1565c0",
    "information-bright": "#0d47a1",
    "information-dim": "#4f78a8",
    "information-light": "#90b8e0",

    "warning": "#a65f00",
    "warning-bright": "#7a4500",
    "warning-dim": "#9a7332",
    "warning-light": "#d9a85b",

    "trace": "#616161",
    "trace-bright": "#212121",
    "trace-dim": "#8a8a8a",
    "trace-light": "#b0b0b0"
  },

  "shell": {
    "background": "shell-bg",
    "foreground": "shell-fg"
  },

  "messages": {
    "error": {
      "icon": "⛔",
      "title": "error-bright",
      "body": "error",
      "verbose": "error-dim",
      "timestamp": "error-dim",
      "metric": "error-bright",
      "stack-trace": "error-dim"
    },
    "warning": {
      "icon": "⚠️",
      "title": "warning-bright",
      "body": "warning",
      "verbose": "warning-dim",
      "timestamp": "warning-dim",
      "metric": "warning-bright",
      "stack-trace": "warning-dim"
    },
    "success": {
      "icon": "✅",
      "title": "success-bright",
      "body": "success",
      "verbose": "success-dim",
      "timestamp": "success-dim",
      "metric": "success-bright",
      "stack-trace": "success-dim"
    },
    "information": {
      "icon": "ℹ",
      "title": "information-bright",
      "body": "information",
      "verbose": "information-dim",
      "timestamp": "information-dim",
      "metric": "information-bright",
      "stack-trace": "information-dim"
    },
    "trace": {
      "icon": "·",
      "title": "trace-bright",
      "body": "trace",
      "verbose": "trace-dim",
      "timestamp": "trace-dim",
      "metric": "trace-bright",
      "stack-trace": "trace-dim"
    }
  },

  "syntax": {
    "keyword": "#0000cc",
    "comment": "#2e7d32",
    "string": "#a31515",
    "number": "#098658",
    "identifier": "#001080",
    "identifier-class": "#267f99",
    "identifier-const": "#795e26"
  },

  "splash": {
    "logo": "#3e61ff",
    "title": "#0C0A50"
  }
}
