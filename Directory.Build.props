<Project>

  <PropertyGroup>
    <!-- the single version source for every project; a release tag must equal v<VersionPrefix>[-suffix], the suffix passed as -p:VersionSuffix. -->
    <VersionPrefix>0.2.8</VersionPrefix>
    <!-- the RDCore.SDK package every project builds on, which brings the RDCore.SDK.Protocols package it depends on: one version for all of them. -->
    <RDCoreSdkVersion>0.1.18-alpha</RDCoreSdkVersion>
    <!-- the RDCore.Forms package the RDForms form host builds on (the RDCore.Forms and RDCore.Forms.Avalonia assemblies are inside it), and the Avalonia it is
         built with: the host starts Avalonia itself. A build on packages that are not published passes their version and feed, as -p:RDCoreSdkVersion,
         -p:RDCoreFormsVersion and -p:RestoreConfigFile. -->
    <RDCoreFormsVersion>0.1.6-alpha</RDCoreFormsVersion>
    <AvaloniaVersion>12.0.5</AvaloniaVersion>
    <!-- the runtimes the platform is published for (release.yml builds a tree of each), and that rdc build can make a program for wherever it runs: the
         published rdc ships the .NET application host of each (RDCore.CLI.csproj), which tools/release/Test-PlatformTree.ps1 checks. -->
    <PlatformRuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</PlatformRuntimeIdentifiers>
  </PropertyGroup>

  <!-- what every assembly of the platform says about itself. A project states its own title and description. -->
  <PropertyGroup>
    <Company>9562-7303 Québec inc.</Company>
    <Authors>$(Company)</Authors>
    <Product>RDCore</Product>
    <Copyright>Copyright © 2026 $(Company)</Copyright>
    <!-- the strings in a project's .resx are English; the .fr.resx beside it is the French satellite. -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- the licence's text is LICENSE-GPLv3.md. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://rubberduckvba.ca</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rubberduck-vba/RDCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- every project, its tests included, builds with no warning: a warning is an error. An advisory published against a package is a warning still, which a
       build reports without failing - it is news of the package, not of the code built. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
