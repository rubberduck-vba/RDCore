<Project>

  <PropertyGroup>
    <!-- the single version source for every project; a release tag must equal v<VersionPrefix>[-suffix], the suffix passed as -p:VersionSuffix. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- what every assembly of the platform says about itself. A project states its own title and description, and its licence when it is not GPLv3. -->
  <PropertyGroup>
    <Company>9562-7303 Québec inc.</Company>
    <Authors>$(Company)</Authors>
    <Product>RDCore</Product>
    <Copyright>Copyright © 2026 $(Company)</Copyright>
    <!-- the strings in a project's .resx are English; the .fr.resx beside it is the French satellite. -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- the licence's text is LICENSE-GPLv3.md; the SDK, its protocol and the tests are MIT (LICENSE-MIT.md) and say so in their project. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://rubberduckvba.ca</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rubberduck-vba/RDCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
