<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyTitle>RDCore External</AssemblyTitle>
    <Description>The platform-independent abstractions the RD-VBA runtime reaches the outside world through: COM automation and native calls.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDCore.SDK\RDCore.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ExternalMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ExternalMessages.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ExternalMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ExternalMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RDCore.Tests" />
    <!-- the Windows implementations of its abstractions say what fails in the same words: ExternalMessages. -->
    <InternalsVisibleTo Include="RDCore.External.Windows" />
  </ItemGroup>

</Project>
