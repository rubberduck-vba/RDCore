<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>RDCore.LanguageServer.Program</StartupObject>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyTitle>RDCore Language Server</AssemblyTitle>
    <Description>The RDCore language server: assembles the platform from its manifest, coordinates its processes, and serves the Language Server Protocol to editors.</Description>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Debugging\DebuggerMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DebuggerMessages.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Debugging\DebuggerMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DebuggerMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Progress\ProgressMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ProgressMessages.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Progress\ProgressMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ProgressMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Workspace\WorkspaceMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>WorkspaceMessages.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Workspace\WorkspaceMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>WorkspaceMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Runtime\RuntimeMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>RuntimeMessages.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Runtime\RuntimeMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>RuntimeMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="OmniSharp.Extensions.DebugAdapter.Server" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageProtocol" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RDCore.SDK" Version="$(RDCoreSdkVersion)" />
    <!-- the static front end the workspace is analysed with; never the runtime, which only the environment host loads. -->
    <ProjectReference Include="..\RDCore.Runtime.LanguageCore\RDCore.Runtime.LanguageCore.csproj" />
    <!-- the symbols of the workspace, built from the syntax trees the parser hands over. -->
    <ProjectReference Include="..\RDCore.Symbols\RDCore.Symbols.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Server\RDCoreDiagnosticsResources.en-US.resx">
      <Generator></Generator>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Server\RDCoreDiagnosticsResources.fr-CA.resx">
      <Generator></Generator>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
