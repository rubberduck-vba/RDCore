<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyTitle>RDCore Runtime</AssemblyTitle>
    <Description>The RD-VBA runtime: the run-time semantics of MS-VBAL, the interpreter and compiled execution, and the VBA standard library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- the file system of an analysis: the analyzed code's file statements act on one in memory, never on the real one. -->
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RDCore.SDK" Version="$(RDCoreSdkVersion)" />
    <!-- the static front end the runtime binds and plans the code it runs with: what the language server analyses it with. -->
    <ProjectReference Include="..\RDCore.Runtime.LanguageCore\RDCore.Runtime.LanguageCore.csproj" />
    <!-- what the runtime reaches the outside world through: abstractions only, whatever the platform implements them with. -->
    <ProjectReference Include="..\RDCore.External\RDCore.External.csproj" />
    <!-- the invokers of the standard library's members, generated from its declarations (StdLibInvokers): a compile-time tool, no reference. -->
    <ProjectReference Include="..\RDCore.Runtime.Generators\RDCore.Runtime.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
    <Folder Include="Semantics\Statements\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Exceptions.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Exceptions.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Exceptions.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Exceptions.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
