<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyTitle>RDCore Runtime Support</AssemblyTitle>
    <Description>What runs an RD-VBA program outside rdc: the session a program runs in, composed from its project and the platform it runs on, and the runner rdc run and a built program share.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="rdc" />
    <InternalsVisibleTo Include="RDCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- a built program's closure is this assembly's references: never RDCore.Parsing or ANTLR, whose third-party GPL parts NOTICE's grant does not
       cover. A test fails when one appears. -->
  <ItemGroup>
    <ProjectReference Include="..\RDCore.SDK\RDCore.SDK.csproj" />
    <ProjectReference Include="..\RDCore.Runtime\RDCore.Runtime.csproj" />
    <!-- what a program reaches outside the platform, on the platform it runs on. -->
    <ProjectReference Include="..\RDCore.External\RDCore.External.csproj" />
    <ProjectReference Include="..\RDCore.External.Windows\RDCore.External.Windows.csproj" />
    <ProjectReference Include="..\RDCore.Symbols\RDCore.Symbols.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
