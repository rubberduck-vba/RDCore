    <add key="globalPackagesFolder" value="C:\Dev\Claude\sdk-port\packages-nov09" />
  </config>
  <packageSources>
    <add key="rdcore-sdk-dry-run" value="C:\Dev\Claude\sdk-port\feed-nov09" />
  </packageSources>
</configuration>
