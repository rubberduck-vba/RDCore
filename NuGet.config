<?xml version="1.0" encoding="utf-8"?>
<!-- LOCAL ONLY: the RDCore.SDK package from a local folder feed, a dotnet pack of an SDK branch under a version no release uses (0.1.2-local.<sha>), restored
     into a packages folder of its own so that this machine's global packages folder never caches a local build. A branch with this file restores on this
     machine only, and stays off CI. The SDK release it is part of is tagged first; then this file is dropped and RDCoreSdkVersion names that release. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="C:\Dev\Claude\sdk-refcheck-packages" />
  </config>
  <packageSources>
    <add key="rdcore-sdk-local" value="C:\Dev\Claude\sdk-refcheck-feed" />
  </packageSources>
</configuration>
