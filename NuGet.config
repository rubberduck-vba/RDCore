<?xml version="1.0" encoding="utf-8"?>
<!-- LOCAL ONLY: the RDCore.SDK package from a local folder feed (a dotnet pack of the SDK branch that gives VBEnumType, VBStdModuleType and VBErrorType
     one constructor each, and removes VBCollectionType and IEnumerableType), restored into a packages folder of its own so that this machine's global packages folder never caches a local
     build under a version nuget.org will publish. A branch with this file restores on this machine only, and stays off CI. The bump PR drops this file and
     restores RDCore.SDK from nuget.org. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="C:\Dev\Claude\sdk-ctor-feed-packages" />
  </config>
  <packageSources>
    <add key="rdcore-sdk-local" value="C:\Dev\Claude\sdk-ctor-feed" />
  </packageSources>
</configuration>
