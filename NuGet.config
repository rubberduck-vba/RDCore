<?xml version="1.0" encoding="utf-8"?>
<!-- LOCAL ONLY: the RDCore.Forms packages and the next RDCore.SDK from local folder feeds (a dotnet pack of each), restored into a packages folder of their own
     so that this machine's global packages folder never caches a local build under a version nuget.org will publish. A branch with this file restores on this
     machine only, and stays off CI. The PR that adopts the real packages drops this file and restores them from nuget.org. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="C:\Dev\Claude\forms-feed-packages" />
  </config>
  <packageSources>
    <add key="rdcore-forms-local" value="C:\Dev\Claude\forms-feed" />
    <add key="rdcore-sdk-next-local" value="C:\Dev\Claude\sdk-015-feed" />
  </packageSources>
</configuration>
