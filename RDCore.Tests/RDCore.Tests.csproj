<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>RDCore Tests</AssemblyTitle>
    <Description>The tests of the RDCore platform.</Description>
    <!-- a test method that does not await what it asserts passes without asserting it: an async method with no await, and a call whose task is dropped. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1998;CS4014</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.3" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="OmniSharp.Extensions.DebugAdapter.Client" Version="0.19.9" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDCore.CLI\RDCore.CLI.csproj" />
    <ProjectReference Include="..\RDCore.Diagnostics\RDCore.Diagnostics.csproj" />
    <ProjectReference Include="..\RDCore.LanguageServer\RDCore.LanguageServer.csproj" />
    <ProjectReference Include="..\RDCore.Parsing\RDCore.Parsing.csproj" />
    <ProjectReference Include="..\RDCore.ParseServer\RDCore.ParseServer.csproj" />
    <ProjectReference Include="..\RDCore.Symbols\RDCore.Symbols.csproj" />
    <ProjectReference Include="..\RDCore.Runtime\RDCore.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- form designer fixtures: binary .frx/storage files, read as bytes on every platform -->
    <EmbeddedResource Include="Workspace\Forms\Fixtures\**" />
    <!-- Rubberduck's indenter test cases (GPLv3), as data: input, settings, expected output -->
    <EmbeddedResource Include="Formatting\Data\rubberduck-indenter-cases.json" LogicalName="RubberduckIndenterCases" />
    <!-- a type library declared in terms of a library no machine has, loaded from its file by export-library -->
    <None Include="Cli\Data\Widgets.tlb" CopyToOutputDirectory="PreserveNewest" />
    <!-- the program that makes it, run on its own (dotnet run MakeWidgetsTlb.cs): not a source of the tests -->
    <Compile Remove="Cli\Data\MakeWidgetsTlb.cs" />
    <None Include="Cli\Data\MakeWidgetsTlb.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
