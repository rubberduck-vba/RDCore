<Project Sdk="Microsoft.NET.Sdk">

  <!-- what the runtime's compilation generates code with: a Roslyn component, which runs inside the compiler and so targets what the compiler loads. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <AssemblyTitle>RDCore Runtime Generators</AssemblyTitle>
    <Description>The source generators of the RDCore runtime: they write the invokers of the VBA standard library's members from its declarations, at compile time.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
