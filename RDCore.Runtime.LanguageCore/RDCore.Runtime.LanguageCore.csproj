<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>RDCore Language Core</AssemblyTitle>
    <Description>The static front end of MS-VBAL: name resolution, the static semantics of expressions and statements, operation plans, and the bound tree, shared by the runtime and the language server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDCore.SDK\RDCore.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RDCore.LanguageServer" />
    <InternalsVisibleTo Include="RDCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
